{
    "name": "iamchristo/finance-platform",
    "description": "Simulated multi-vertical fintech platform: investment, forex/trading, real estate",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "nikic/fast-route": "^1.3",
        "league/plates": "^3.6",
        "respect/validation": "^2.3",
        "phpmailer/phpmailer": "^6.9",
        "monolog/monolog": "^3.7",
        "symfony/console": "^7.1",
        "vlucas/phpdotenv": "^5.6",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
